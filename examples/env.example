# DeepSeek Responses API. Prefer Pi /login or export this locally.
DEEPSEEK_API_KEY=

# Provider-side DeepSeek Web Search: off (default), auto, or force.
PI_DEEPSEEK_WEB_SEARCH=off

# Optional: suppress the one-time interactive setup hint shown after each kit version update.
# YIMO_PI_KIT_HIDE_STARTUP_HINT=1

# Optional custom gateway key rotation. Never commit real values.
YIMO_PI_GATEWAY_KEY_1=
YIMO_PI_GATEWAY_KEY_2=

# Optional subagent parallelism; defaults to 2 and is capped at 8.
YIMO_PI_SUBAGENT_CONCURRENCY=2

# Optional explicit extension overrides for advanced installations.
# YIMO_PI_MCP_ADAPTER_EXTENSION=/absolute/path/to/pi-mcp-adapter/index.ts
# YIMO_PI_FAILOVER_EXTENSION=/absolute/path/to/api-key-failover/index.ts

# Optional MCP credentials.
# CONTEXT7_API_KEY=
