{
  "name": "yimo-pi-kit",
  "version": "0.4.1",
  "description": "A portable Pi coding-agent profile with extensions, subagents, skills, prompts, themes, DeepSeek Responses Web Search, and optional local code-review graph/MCP integration.",
  "type": "module",
  "license": "MIT",
  "author": "yimo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baka-world/yimo-pi-kit.git"
  },
  "homepage": "https://github.com/baka-world/yimo-pi-kit",
  "bugs": {
    "url": "https://github.com/baka-world/yimo-pi-kit/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "agent-skills",
    "mcp",
    "deepseek",
    "responses-api",
    "web-search",
    "code-review",
    "knowledge-graph"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "agents",
    "docs",
    "examples",
    "extensions",
    "mcp",
    "prompts",
    "scripts",
    "skills",
    "themes",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "yimo-pi-kit": "./scripts/cli.mjs"
  },
  "scripts": {
    "check": "npm run typecheck && node ./scripts/check.mjs",
    "audit:prod": "npm audit --omit=dev",
    "release:check": "npm run check && npm run audit:prod && npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "doctor": "node ./scripts/cli.mjs doctor",
    "setup:mcp": "node ./scripts/cli.mjs setup-mcp",
    "setup:code-review": "node ./scripts/cli.mjs setup-code-review",
    "setup:deepseek": "node ./scripts/cli.mjs setup-deepseek",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "strip-json-comments": "5.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^26.1.2",
    "typebox": "1.3.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/00-safe-temp/index.ts",
      "./extensions/api-key-failover/index.ts",
      "./extensions/auto-context/index.ts",
      "./extensions/confirm-destructive/index.ts",
      "./extensions/custom-compaction/index.ts",
      "./extensions/deepseek-web-search.ts",
      "./extensions/dirty-repo-guard/index.ts",
      "./extensions/git-checkpoint/index.ts",
      "./extensions/kit-manager/index.ts",
      "./extensions/latex-render/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/summarize/index.ts",
      "./extensions/task-notifier/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/worklog.ts",
      "./extensions/better-custom/index.ts"
    ],
    "skills": [
      "./skills/academic-research-tooling/SKILL.md",
      "./skills/backend-engineering/SKILL.md",
      "./skills/code-review-graph-usage/SKILL.md",
      "./skills/frontend-engineering/SKILL.md",
      "./skills/public-dataset-research-sop/SKILL.md",
      "./skills/security-engineering/SKILL.md",
      "./skills/software-architecture/SKILL.md"
    ],
    "prompts": [
      "./prompts/implement-and-review.md",
      "./prompts/implement.md",
      "./prompts/scout-and-plan.md"
    ],
    "themes": [
      "./themes/catppuccin-frappe.json",
      "./themes/catppuccin-latte.json",
      "./themes/catppuccin-macchiato.json",
      "./themes/catppuccin-mocha.json"
    ]
  }
}
