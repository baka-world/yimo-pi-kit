{
  "settings": { "showStatusIcon": false, "outputGuard": true },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@3.2.3", "--transport", "stdio"],
      "lifecycle": "lazy",
      "requestTimeoutMs": 60000,
      "exposeResources": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.78", "--headless", "--isolated", "--output-mode", "stdout"],
      "lifecycle": "lazy",
      "requestTimeoutMs": 90000,
      "exposeResources": false
    }
  }
}
