{
  "settings": {
    "autoAuth": false,
    "hostConfigDiscovery": "off",
    "showStatusIcon": true,
    "outputGuard": true
  },
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--no-config",
        "--no-env-file",
        "--no-python-downloads",
        "--no-build",
        "--no-sources",
        "--link-mode",
        "copy",
        "--no-progress",
        "--color",
        "never",
        "--python",
        "__YIMO_PI_KIT_PYTHON__",
        "--default-index",
        "https://pypi.org/simple",
        "--index-strategy",
        "first-index",
        "--keyring-provider",
        "disabled",
        "--exclude-newer",
        "2026-07-18T00:34:12Z",
        "--with",
        "cryptography==50.0.0",
        "--exclude-newer-package",
        "cryptography=2026-07-31T14:25:11Z",
        "--from",
        "code-review-graph @ https://files.pythonhosted.org/packages/f3/8f/2df3fcca285b489d195706b09cefda3e57e7158185cb83905200d7b27199/code_review_graph-2.3.7-py3-none-any.whl#sha256=12196dce3e673bdec7fba97ae5c4dff7589adee73a721374f62efae76e0fdd88",
        "python",
        "-I",
        "__YIMO_PI_KIT_CODE_REVIEW_RUNNER__",
        "serve",
        "--tools",
        "build_or_update_graph_tool,get_minimal_context_tool,get_impact_radius_tool,query_graph_tool,semantic_search_nodes_tool,get_review_context_tool,list_graph_stats_tool,get_docs_section_tool,get_affected_flows_tool,detect_changes_tool"
      ],
      "env": {
        "HOME": "${HOME}/.cache/yimo-pi-kit/code-review-graph-home",
        "UV_CACHE_DIR": "${HOME}/.cache/yimo-pi-kit/code-review-graph-uv",
        "UV_ISOLATED": "1",
        "UV_NO_CONFIG": "1",
        "UV_NO_ENV_FILE": "1",
        "UV_NO_SOURCES": "1",
        "UV_NO_BUILD": "1",
        "UV_LINK_MODE": "copy",
        "UV_NO_PROGRESS": "1",
        "UV_DEFAULT_INDEX": "https://pypi.org/simple",
        "UV_INDEX": "",
        "UV_INDEX_URL": "",
        "UV_EXTRA_INDEX_URL": "",
        "UV_FIND_LINKS": "",
        "UV_CONSTRAINT": "",
        "UV_BUILD_CONSTRAINT": "",
        "UV_OVERRIDE": "",
        "UV_INDEX_STRATEGY": "first-index",
        "UV_PRERELEASE": "disallow",
        "UV_EXCLUDE_NEWER": "2026-07-18T00:34:12Z",
        "UV_KEYRING_PROVIDER": "disabled",
        "UV_PYTHON_DOWNLOADS": "never",
        "PYTHONPATH": "",
        "PYTHONHOME": "",
        "PYTHONSTARTUP": "",
        "PYTHONBREAKPOINT": "0",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
        "PYTHONUTF8": "1",
        "PYTHONUSERBASE": "",
        "VIRTUAL_ENV": "",
        "CONDA_PREFIX": "",
        "NODE_OPTIONS": "",
        "NODE_PATH": "",
        "FASTMCP_ENV_FILE": "__YIMO_PI_KIT_FASTMCP_ENV__",
        "FASTMCP_HOME": "__YIMO_PI_KIT_FASTMCP_HOME__",
        "FASTMCP_TRANSPORT": "stdio",
        "FASTMCP_CHECK_FOR_UPDATES": "off",
        "FASTMCP_SHOW_SERVER_BANNER": "false",
        "FASTMCP_DEBUG": "false",
        "FASTMCP_DOCKET_URL": "memory://",
        "OTEL_PROPAGATORS": "none",
        "OTEL_PYTHON_TRACER_PROVIDER": "default_tracer_provider",
        "OTEL_PYTHON_METER_PROVIDER": "default_meter_provider",
        "OTEL_TRACES_EXPORTER": "none",
        "OTEL_METRICS_EXPORTER": "none",
        "OTEL_LOGS_EXPORTER": "none",
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_OPTIONAL_LOCKS": "0",
        "YIMO_PI_KIT_NODE": "__YIMO_PI_KIT_NODE__",
        "YIMO_PI_KIT_GIT_SHIM": "__YIMO_PI_KIT_GIT_SHIM__",
        "YIMO_PI_KIT_CODE_REVIEW_PROFILE": "managed-v1",
        "CRG_REPO_ROOT": "",
        "CRG_DATA_DIR": "",
        "CRG_TOOLS": "build_or_update_graph_tool,get_minimal_context_tool,get_impact_radius_tool,query_graph_tool,semantic_search_nodes_tool,get_review_context_tool,list_graph_stats_tool,get_docs_section_tool,get_affected_flows_tool,detect_changes_tool",
        "CRG_RECURSE_SUBMODULES": "0",
        "CRG_ALLOW_REMOTE_CODE": "0",
        "CRG_BFS_ENGINE": "sql",
        "CRG_PARSE_WORKERS": "4",
        "CRG_PARSE_EXECUTOR": "thread",
        "CRG_SERIAL_PARSE": "0",
        "CRG_PARSER_LOAD_TIMEOUT_SECONDS": "5",
        "CRG_GIT_TIMEOUT": "30",
        "CRG_DEPENDENT_HOPS": "2",
        "CRG_CHURN_WINDOW_DAYS": "90",
        "CRG_MAX_CHANGED_FUNCS": "500",
        "CRG_MAX_TRANSITIVE_FRONTIER": "50",
        "CRG_MAX_IMPACT_NODES": "500",
        "CRG_MAX_IMPACT_DEPTH": "2",
        "CRG_MAX_BFS_DEPTH": "15",
        "CRG_MAX_SEARCH_RESULTS": "20",
        "CRG_IMPACT_DEPTH_DECAY": "0.6",
        "CRG_IMPACT_SCORE_FLOOR": "0.05",
        "CRG_LEIDEN_SEED": "42",
        "CRG_TOOL_TIMEOUT": "300",
        "CRG_ACCEPT_CLOUD_EMBEDDINGS": "0",
        "CRG_EMBEDDING_MODEL": "",
        "CRG_OPENAI_API_KEY": "",
        "CRG_OPENAI_BASE_URL": "",
        "CRG_OPENAI_MODEL": "",
        "CRG_OPENAI_BATCH_SIZE": "",
        "CRG_OPENAI_DIMENSION": "",
        "MINIMAX_API_KEY": "",
        "GOOGLE_API_KEY": ""
      },
      "lifecycle": "lazy",
      "requestTimeoutMs": 300000,
      "exposeResources": false,
      "directTools": false,
      "includeTools": [
        "build_or_update_graph_tool",
        "get_minimal_context_tool",
        "get_impact_radius_tool",
        "query_graph_tool",
        "semantic_search_nodes_tool",
        "get_review_context_tool",
        "list_graph_stats_tool",
        "get_docs_section_tool",
        "get_affected_flows_tool",
        "detect_changes_tool"
      ]
    }
  }
}
